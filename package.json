{
  "name": "fluffdesk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b packages/core packages/db packages/eval apps/api && tsc -p apps/api/tsconfig.test.json && tsc -p packages/db/tsconfig.test.json && tsc -p apps/web/tsconfig.json --noEmit",
    "design:build": "node packages/design/scripts/tokens-to-css.mjs",
    "design:check": "node packages/design/scripts/tokens-to-css.mjs --check",
    "test": "vitest run",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "eval": "npm run eval -w packages/eval --",
    "import": "tsx --env-file-if-exists=.env apps/api/src/cli/import.ts",
    "test:mutate": "bash scripts/mutate.sh",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:seed": "npm run db:seed -w packages/db --",
    "deploy:api": "bash scripts/deploy-api.sh",
    "deploy:web": "bash scripts/deploy-web.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.8",
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6"
  }
}
