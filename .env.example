FLUFF_VISION_MODEL=anthropic/claude-haiku-5-5
FLUFF_JUDGE_MODEL=anthropic/claude-sonnet-5-5
FLUFF_FALLBACK_MODEL=deepseek/deepseek-v4-pro

# ---- 数据 ----
DATABASE_URL=postgres://user:pass@host.ap-southeast-2.aws.neon.tech/fluffdesk?sslmode=require

# ---- 服务 ----
PORT=8787
WEB_ORIGIN=http://localhost:3000

