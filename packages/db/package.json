{
  "name": "@fluffdesk/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx --env-file-if-exists=../../.env src/check.ts",
    "db:app-role": "tsx --env-file-if-exists=../../.env src/create-app-role.ts"
  },
  "dependencies": {
    "@fluffdesk/core": "*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.20.6"
  }
}
